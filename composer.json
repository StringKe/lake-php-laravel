{
  "name": "stringke/lake-php-laravel",
  "description": "Laravel database driver for TiDB Cloud Lake and Databend on top of the pdo_lake extension",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "laravel",
    "database",
    "pdo",
    "databend",
    "tidb",
    "lake"
  ],
  "homepage": "https://github.com/stringke/lake-php-laravel",
  "support": {
    "issues": "https://github.com/stringke/lake-php-laravel/issues",
    "source": "https://github.com/stringke/lake-php-laravel"
  },
  "require": {
    "php": ">=8.4",
    "ext-pdo_lake": ">=0.1.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.32",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.2"
  },
  "autoload": {
    "psr-4": {
      "StringKe\\LakePhp\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StringKe\\LakePhp\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "StringKe\\LakePhp\\Laravel\\LakeServiceProvider"
      ]
    }
  },
  "scripts": {
    "lint": "pint --test",
    "format": "pint",
    "typecheck": "phpstan analyse --no-progress",
    "test": "pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
